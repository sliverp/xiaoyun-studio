{
  "name": "xiaoyun-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent AI virtual-presenter studio with headless rendering and RTMP output",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/main.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:media": "node scripts/media-smoke.mjs",
    "test:ux": "node scripts/workspace-smoke.mjs",
    "test:audio": "node scripts/audio-continuity-smoke.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:login-ui": "node scripts/remote-login-ui-smoke.mjs",
    "browser:local": "node scripts/local-browser-helper.mjs",
    "test:session": "node scripts/browser-session-smoke.mjs",
    "test:multi-wechat": "node scripts/multi-wechat-smoke.mjs",
    "test:chat-recovery": "node scripts/channels-watchdog-smoke.mjs",
    "test:helper-ui": "node scripts/local-helper-ui-smoke.mjs",
    "test:workspace-login": "node scripts/local-workspace-smoke.mjs",
    "test:browser-lifecycle": "node scripts/local-browser-lifecycle-smoke.mjs",
    "test:presentation-preview": "node scripts/presentation-preview-smoke.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "pdfjs-dist": "^6.4.299",
    "protobufjs": "^8.8.1",
    "puppeteer-core": "^24.37.5",
    "tencentcloud-sdk-nodejs-tts": "^4.1.180",
    "ws": "^8.18.3"
  }
}
