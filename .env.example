# Required for Docker. Use a unique password with at least 12 characters.
STUDIO_ADMIN_PASSWORD=
STUDIO_PORT=18080
# Optional SenseVoice sidecar: set this AND run compose with --profile voice.
STUDIO_ASR_BASE_URL=
# STUDIO_ASR_BASE_URL=http://asr:10095/v1
# Set 1 only behind your own HTTPS reverse proxy.
STUDIO_SECURE_COOKIE=0
# Private-network slide URLs are blocked by default; uploaded HTML works locally.
ALLOW_PRIVATE_PRESENTATIONS=0
